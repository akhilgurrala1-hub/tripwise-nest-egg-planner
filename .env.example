# Public values (they ship to the browser). Copy to .env.local and fill in for local work.
# Secrets never go in a committed file: set them in the Vercel project's environment variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Secrets (Vercel environment variables, or .env.local locally; never commit)
GEMINI_API_KEY=
SERPAPI_API_KEY=
EIA_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Affiliate links (optional, public). Leave empty until a partner agreement is approved.
# One JSON value; partner ids are listed in src/lib/partners/config.ts. Example shape:
# VITE_AFFILIATE_PARTNERS={"booking":{"param":"<name from the partner's docs>","value":"<your ID>"}}
VITE_AFFILIATE_PARTNERS=
